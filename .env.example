# Base URL of the website (without trailing slash)
# Used for canonical URLs, sitemap, robots, RSS feeds, and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://abdulrahmon-sulaimon.vercel.app

# Search engine verification tokens (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token
# NEXT_PUBLIC_BING_SITE_VERIFICATION=your-bing-verification-token

# Active color palette: signal (default) | ember | ocean | violet
NEXT_PUBLIC_PALETTE=signal

# ==============================================================================
# Resend Email Delivery Configuration (Contact Form)
# ==============================================================================
# Your Resend API Key (obtain from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email address where contact form submissions will be delivered
CONTACT_EMAIL=owner@example.com

# Verified sender address configured in Resend.
# For testing with the Resend sandbox, use: onboarding@resend.dev
# In production, use an address with your verified domain, e.g.: Contact <contact@abdulrahmon.tech>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Optional: Upstash Redis for distributed/persistent rate limiting across serverless lambdas.
# Obtain from https://console.upstash.com. If omitted, an in-memory sliding-window limiter is used.
# UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Optional: Cloudflare Turnstile (Privacy-friendly Bot Protection)
# Obtain from https://dash.cloudflare.com/?to=/:account/turnstile
# If omitted, Turnstile is bypassed cleanly without breaking the form.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_site_key_placeholder
# TURNSTILE_SECRET_KEY=0x4AAAAAA_secret_key_placeholder
